# Slack Webhook URL for posting draft cards
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# Ngrok Domain (optional if using static ngrok domain)
NGROK_DOMAIN="matted-crested-hesitancy.ngrok-free.dev"

# Ngrok Authtoken
NGROK_AUTHTOKEN="YOUR_NGROK_AUTHTOKEN"

# Tweet Generation Interval in Hours (default: 1)
GENERATE_INTERVAL_HOURS=1

# Optional: Twitter (X) auth_token cookie for direct instant authentication
# X_AUTH_TOKEN="YOUR_TWITTER_AUTH_TOKEN_COOKIE"

# OpenRouter API Key and Model for AI tweet generation
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="openrouter/free"
